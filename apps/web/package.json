{
  "name": "@tessera/web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "vite build && playwright test",
    "e2e:pages": "BASE_PATH=/tessera/ vite build && E2E_PAGES=1 playwright test"
  },
  "dependencies": {
    "@tessera/platform": "workspace:*",
    "@tessera/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
